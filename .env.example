# ── Portas externas (host) ────────────────────────────────────────────────
API_PORT=8080
DB_PORT=5432

# ── Banco de Dados ────────────────────────────────────────────────────────
POSTGRES_DB=consultorio
POSTGRES_USER=consultorio_user
POSTGRES_PASSWORD=troque_esta_senha

# ── JWT ───────────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
JWT_SECRET=troque_este_secret
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30

# ── MinIO (armazenamento de fotos) ────────────────────────────────────────
MINIO_ACCESS_KEY=troque_este_access_key
MINIO_SECRET_KEY=troque_este_secret_key
MINIO_BUCKET=consultorio-photos
