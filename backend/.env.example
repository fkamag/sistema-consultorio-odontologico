# Copie este arquivo para .env e preencha os valores
# O arquivo .env nunca deve ser commitado no repositório

# Portas externas (host)
API_PORT=8086
DB_PORT=5441

# Banco de Dados
POSTGRES_DB=consultorio
POSTGRES_USER=consultorio_user
POSTGRES_PASSWORD=troque_esta_senha

# JWT
JWT_SECRET=troque_por_uma_chave_secreta_com_no_minimo_256_bits
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=30
